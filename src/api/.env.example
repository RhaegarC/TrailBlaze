# Copy to .env in this directory and fill in. `.env` is gitignored (.gitignore:34-36);
# this example is tracked, which is why it holds no value.
#
#   cp .env.example .env
#
# Read by `docker compose`, for both `docker-compose.yml` (the local stack) and
# `docker-compose.test.yml` (the test tier's containers). Only the first needs a value from you.

# Required by the compose file — it has no default, so `up` fails without it.
# SQL Server's own complexity rule applies (8+ chars, three of: upper, lower, digit, symbol).
MSSQL_SA_PASSWORD=

# ---------------------------------------------------------------------------------------
# The test tier does NOT read this file. `docker compose` reads .env; a `dotnet test` run
# reads the process environment, which is a different thing. Export these in the shell you
# run the tests from — neither is required, and the defaults below are what the suite uses
# when they are absent.
#
# Both are shown as comments because a full connection string here would be a credential in
# a tracked file the moment someone uncommented it.
#
# The SQL string is normally not needed at all: the tests compose it from MSSQL_SA_PASSWORD,
# which is the same variable compose uses. Set it only to point somewhere else.
#
# TRAILBLAZE_SQL_CONNECTION=Server=127.0.0.1,1433;Database=master;User Id=sa;Password=<MSSQL_SA_PASSWORD>;Encrypt=True;TrustServerCertificate=True
#
# Storage needs no secret: the default is the Azurite emulator with Microsoft's published
# development account key, so `dotnet test` runs against it with nothing exported at all.
# Set this only to point at the real account.
#
# TRAILBLAZE_STORAGE_CONNECTION=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=<published Azurite key>;BlobEndpoint=http://127.0.0.1:10000/devstoreaccount1;

# ---------------------------------------------------------------------------------------
# The local stack (`docker-compose.yml`) reads these. All three are OPTIONAL — each has a
# default in the compose file — and blank is a meaningful value for the last two.
#
# `dotnet user-secrets` cannot reach a container, so for the stack this file is the only way
# to set them. A host `dotnet run` still uses user-secrets; the two do not share a source.

# Comma-separated browser origins allowed to call the API. Defaults to the API's own launch
# URLs, which is what appsettings.Development.json already carries. Repoint it at the web
# app's origin once feature 10 exists. A semicolon here silently matches nothing.
#
# AllowedOrigins=https://localhost:8086,http://localhost:8080

# Entra ID. Both or neither: one alone leaves the bearer scheme unwired, every request is
# anonymous, and the API logs a startup warning saying so.
#
# There is no development tenant yet, and an `oid` is signed by Entra, so a principal cannot
# be faked locally. While these are blank every [Authorize] route — media and cover upload,
# the profile routes — answers 500, not 401: there is no scheme to challenge with, so the
# challenge throws. The blob path therefore cannot be exercised at all until a tenant exists
# (testing-and-tdd.md records the same behaviour for the Api host tier).
#
# TenantId=<tenant guid>
# Audience=api://<client-id>
