# Copy to `.env` in this directory and fill in. `.env` is gitignored (.gitignore:34-36);
# this example is tracked, which is why it holds no value.
#
#   cp .env.example .env
#
# `docker compose` reads this file, for both `docker-compose.yml` (the local stack) and
# `docker-compose.test.yml` (the test tier's containers). A `dotnet test` run does NOT read it:
# the tests resolve their own connection strings from the process environment, which is a
# different thing, and they need nothing here.

# Required by both compose files, which have no default — `up` fails without it. SQL Server's own
# complexity rule applies (8+ chars, three of: upper, lower, digit, symbol).
MSSQL_SA_PASSWORD=

# -- Read by the stack's `api` service through `env_file`. Both are required: there is no default
#    in `appsettings.json`, and the API refuses to start without one.
#
#    The host is the compose service name rather than `127.0.0.1` — the API runs inside the same
#    network, and `127.0.0.1` there is the container itself. `Encrypt=True` without
#    `TrustServerCertificate=True` is correct here and wrong for a real server: the name cannot
#    resolve outside the stack (STANDARD §6).
DbConnection=Server=azure-sql-edge,1433;Database=TrailBlaze;User Id=sa;Password=<MSSQL_SA_PASSWORD>;Encrypt=True;TrustServerCertificate=True

#    `tbtestaccount` is the account `docker-compose.yml` starts Azurite with. The key below is
#    Microsoft's published emulator key — a documented constant rather than a credential, but it
#    stays a placeholder in a tracked file. Real value: see `AZURITE_ACCOUNTS` in the compose file.
BlobConnection=DefaultEndpointsProtocol=http;AccountName=tbtestaccount;AccountKey=<Azurite emulator key>;BlobEndpoint=http://azure-storage-edge:10000/tbtestaccount;

# Development is what turns on MapOpenApi, the only IsDevelopment branch in Program.cs.
ASPNETCORE_ENVIRONMENT=Development

# -- Optional. Each has a default, and blank is a meaningful value for the last two.
#
#    Comma-separated browser origins allowed to call the API. Defaults to the API's own launch
#    URLs; the Vite dev server is on 8443. A semicolon here silently matches nothing.
AllowedOrigins=http://localhost:8443

#    Entra ID. Both or neither: one alone leaves the bearer scheme unwired, every request is
#    anonymous, and the API logs a startup warning saying so. While these are blank every
#    `[Authorize]` route — media and cover upload, the profile routes — answers **500, not 401**,
#    because there is no scheme to challenge with, so the blob path cannot be exercised at all.
TenantId=
Audience=
