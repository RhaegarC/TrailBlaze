# Copy to `.env` and fill in. `.env` is gitignored — never commit real values (STANDARD §6).
#
#   cp .env.example .env
#   docker compose up --build

# Connection string for the Azure SQL Database the API runs against.
#
# Development uses a real Azure SQL Database, not a local server — there is no database container
# in docker-compose.yml. Take the connection string Azure gives you (server overview → Connection
# strings → ADO.NET) and paste it whole. It must carry `Encrypt=True` and must **not** set
# `TrustServerCertificate=True`.
#
#   Server=tcp:<server>.database.windows.net,1433;Initial Catalog=TrailBlaze;User ID=<user>;
#   Password=<password>;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;
#
# The database must already exist — the API creates the schema by migrating at startup, not the
# database itself. The server's firewall must also allow the address you connect from.
DB_CONNECTION=

# Azure Storage connection string used by the API's IStorageService.
#
# Azure Blob is a real resource in every environment, development included (PRD Decision #5), so
# this is a real connection string rather than a local emulator. It must carry the account key:
# the implementation signs SAS read URLs locally, which a SAS-only or identity-based connection
# string cannot do.
#
# The three containers it must contain are `covers` and `avatars` (public) and `media` (private).
BLOB_CONNECTION=

# Comma-separated origins allowed by CORS. Optional for compose — it falls back to the local
# API and Vite dev-server origins — but the API refuses to start when it resolves to empty.
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173
